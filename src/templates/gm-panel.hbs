<div class="hintz-manor-app">
  <div class="hintz-manor-header">
    <h2><i class="fa-solid fa-masks-theater"></i> Hintz Manor Control Center</h2>
    <div class="hintz-manor-subtitle">Clue-Style Automated Murder Mystery Engine for Foundry V14</div>
  </div>

  <nav class="hm-tab-nav">
    <button type="button" class="hm-tab-btn {{#if isSetupTab}}active{{/if}}" data-action="switchTab" data-tab="setup">
      <i class="fa-solid fa-sliders"></i> Mystery Setup
    </button>
    <button type="button" class="hm-tab-btn {{#if isMotivesTab}}active{{/if}}" data-action="switchTab" data-tab="motives">
      <i class="fa-solid fa-network-wired"></i> Motive & Relationships
    </button>
    <button type="button" class="hm-tab-btn {{#if isKnowledgeTab}}active{{/if}}" data-action="switchTab" data-tab="knowledge">
      <i class="fa-solid fa-eye"></i> Travel & Sightlines
    </button>
    <button type="button" class="hm-tab-btn {{#if isRosterTab}}active{{/if}}" data-action="switchTab" data-tab="roster">
      <i class="fa-solid fa-users"></i> 13-NPC Roster
    </button>
  </nav>

  <!-- TAB 1: MYSTERY SETUP -->
  {{#if isSetupTab}}
    <div class="hm-tab-content">
      <div class="hm-card-grid" style="grid-template-columns: 1fr 1fr; margin-bottom: 1rem;">
        <div class="hm-card">
          <div class="hm-card-header"><i class="fa-solid fa-bolt"></i> 1-Click Game Setup</div>
          <p style="font-size: 0.85rem; color: var(--hm-text-muted);">Automatically imports 13 NPC actors, generates secret motives, picks killer, victim, weapon, and tool locations.</p>
          <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
            <button type="button" class="hm-btn-primary" data-action="randomizeMystery">
              <i class="fa-solid fa-dice"></i> 1-Click Start & Randomize
            </button>
            <button type="button" class="hm-btn-secondary" data-action="importActors">
              <i class="fa-solid fa-user-plus"></i> Import 13 NPC Actors
            </button>
            <button type="button" class="hm-btn-secondary" data-action="importOpenVTTMaps">
              <i class="fa-solid fa-map-location-dot"></i> Import OpenVTT Maps
            </button>
          </div>
        </div>

        <div class="hm-card">
          <div class="hm-card-header"><i class="fa-solid fa-shield-halved"></i> Current Mystery Status</div>
          <p><strong>Status:</strong> 
            {{#if isSetup}}<span style="color: #ffcc00;">SETUP MODE</span>{{/if}}
            {{#if isInProgress}}<span style="color: #66ff66;">MYSTERY IN PROGRESS</span>{{/if}}
            {{#if isCrimeCommitted}}<span style="color: #ff4444; font-weight: bold;">CRIME COMMITTED!</span>{{/if}}
          </p>
          {{#if isInProgress}}
            <p style="font-size: 0.85rem;"><strong>Secret Killer:</strong> {{mysteryState.killerName}}</p>
            <p style="font-size: 0.85rem;"><strong>Victim:</strong> {{mysteryState.victimName}}</p>
            <p style="font-size: 0.85rem;"><strong>Crime Weapon:</strong> {{mysteryState.requiredWeapon}}</p>
          {{/if}}
          <button type="button" class="hm-btn-secondary" data-action="resetMystery" style="margin-top: 0.4rem;">
            <i class="fa-solid fa-rotate-left"></i> Reset Mystery
          </button>
        </div>
      </div>
    </div>
  {{/if}}

  <!-- TAB 2: MOTIVE & RELATIONSHIP MATRIX -->
  {{#if isMotivesTab}}
    <div class="hm-tab-content">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.8rem;">
        <h3 style="margin: 0; color: var(--hm-gold-light); font-family: var(--hm-font-heading);">
          <i class="fa-solid fa-network-wired"></i> Motive & Secret Relationship Matrix
        </h3>
        <button type="button" class="hm-btn-primary" data-action="generateMotives">
          <i class="fa-solid fa-dice"></i> Generate / Reshuffle Motive Matrix
        </button>
      </div>

      <div class="hm-card-grid" style="max-height: 440px;">
        {{#each motivesList}}
          <div class="hm-card">
            <div class="hm-card-header">
              <span>{{name}} ({{role}})</span>
              {{#if isKiller}}<span style="color: #ff4444; font-weight: bold;">[SECRET KILLER]</span>{{/if}}
              {{#if isVictim}}<span style="color: #ffcc00; font-weight: bold;">[VICTIM]</span>{{/if}}
            </div>
            <p style="font-size: 0.85rem; margin: 0.2rem 0;"><strong>Secret Motive:</strong> {{motive}}</p>
            <p style="font-size: 0.85rem; margin: 0.2rem 0; color: var(--hm-text-muted);"><strong>Hidden Secret:</strong> {{secret}}</p>
          </div>
        {{/each}}
      </div>
    </div>
  {{/if}}

  <!-- TAB 3: TRAVEL & SIGHTLINES -->
  {{#if isKnowledgeTab}}
    <div class="hm-tab-content">
      <h3 style="color: var(--hm-gold-light); font-family: var(--hm-font-heading); margin-bottom: 0.5rem;">
        <i class="fa-solid fa-eye"></i> Per-Turn NPC Travel & Sightlines
      </h3>
      <div class="hm-card-grid" style="max-height: 440px;">
        {{#each npcKnowledge}}
          <div class="hm-card">
            <div class="hm-card-header">{{name}} ({{role}})</div>
            <p style="font-size: 0.85rem; margin: 0.2rem 0;"><strong>Current Location:</strong> {{currentRoom}}</p>
            <p style="font-size: 0.85rem; margin: 0.2rem 0;"><strong>Rooms Visited:</strong> {{roomsVisited}}</p>
            <p style="font-size: 0.85rem; margin: 0.2rem 0;"><strong>Witnessed Tokens:</strong> {{seenTokens}}</p>
            <p style="font-size: 0.85rem; margin: 0.2rem 0;"><strong>Acquired Tools:</strong> {{tools}}</p>
          </div>
        {{/each}}
      </div>
    </div>
  {{/if}}

  <!-- TAB 4: 13-NPC ROSTER -->
  {{#if isRosterTab}}
    <div class="hm-tab-content">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.8rem;">
        <h3 style="margin: 0; color: var(--hm-gold-light); font-family: var(--hm-font-heading);">
          <i class="fa-solid fa-users"></i> Hintz Manor 13-NPC Roster
        </h3>
        <button type="button" class="hm-btn-primary" data-action="importActors">
          <i class="fa-solid fa-user-plus"></i> Import All 13 Actors into Sidebar
        </button>
      </div>

      <div class="hm-card-grid" style="max-height: 440px;">
        {{#each npcRoster}}
          <div class="hm-card">
            <div class="hm-card-header">{{name}}</div>
            <p style="font-size: 0.85rem; margin: 0.2rem 0;"><strong>Role:</strong> {{role}} ({{category}})</p>
            <p style="font-size: 0.85rem; margin: 0.2rem 0;"><strong>Personality:</strong> {{personality}}</p>
            <p style="font-size: 0.85rem; margin: 0.2rem 0;"><strong>Starting Room:</strong> {{startingRoom}}</p>
          </div>
        {{/each}}
      </div>
    </div>
  {{/if}}
</div>
